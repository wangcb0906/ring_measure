{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "cmake_configure",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-DLOG_LEVEL=TRACE",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "detail": "Configure CMake project."
        },
        {
            "type": "shell",
            "label": "build_cali",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "ring_cali",
                "-j",
                "--clean-first"
            ],
            "dependsOn": [
                "cmake_configure"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Task generated to build the project via CMake."
        },
        {
            "type": "shell",
            "label": "build_cali_eval",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "ring_cali_eval",
                "--clean-first",
                "-j",
            ],
            "dependsOn": [
                "cmake_configure"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Task generated to build the project via CMake."
        },
        {
            "type": "shell",
            "label": "build_measure",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "ring_measure",
                "-j",
            ],
            "dependsOn": [
                "cmake_configure"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Task generated to build the project via CMake."
        },
        {
            "label": "Start Wine debugger",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/start-wine-debug.sh",
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "wine-debugger",
                    "pattern": {
                        "regexp": ".*"
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "Starting Wine debugger\\.\\.\\.",
                        "endsPattern": "GDB proxy ready on localhost:40780"
                    }
                }
            ]
        },
        // {
        //     "label": "Start Wine debugger",
        //     "type": "shell",
        //     "command": "${workspaceFolder}/.vscode/start-wine-debug.sh",
        //     "problemMatcher": []
        // },
        {
            "label": "Stop Wine debugger",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/stop-wine-debug.sh",
            "problemMatcher": []
        }
    ]
}