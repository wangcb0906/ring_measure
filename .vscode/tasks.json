{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "cmake_configure",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-DLOG_LEVEL=TRACE",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "detail": "Configure CMake project."
        },
        {
            "type": "shell",
            "label": "build_cali",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "ring_cali",
                "-j",
            ],
            "dependsOn": [
                "cmake_configure"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Task generated to build the project via CMake."
        },
        {
