{
    "version": "0.2.0",
    "configurations": [
       {
            "name": "ring_cali_lldb",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/ring_cali",
            "cwd": "${workspaceFolder}",
            "args": [
                "cali/20260622",
                "-r",
                "4_ND_20260622_4_19.ini",
                "-o", "auto",
                "-p", "auto.ini"
            ],
            "preLaunchTask": "build_cali",
            "initCommands": [
                "script import sys; sys.path.append('/usr/lib/python3.14/site-packages')",
                "command script import ${workspaceFolder}/visual/parse.py",
                "command script import ${workspaceFolder}/visual/line.py",
                "command script import ${workspaceFolder}/visual/profile.py",
                "command script import ${workspaceFolder}/visual/hist.py",
            ]
        },

        {
            "name": "ring_cali_gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ring_cali",
            "cwd": "${workspaceFolder}",
            "args": [
                "cali/20260622",
                "-r",
                "4_ND_20260622_4_19.ini"
            ],
            "preLaunchTask": "build_cali",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreExisting": true
                }
            ]
        },
        
        {
            "name": "ring_cali_eval_lldb",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/ring_cali_eval",
            "cwd": "${workspaceFolder}",
            "args": [
                "cali/20260622"
            ],
            "preLaunchTask": "build_cali_eval",
            "initCommands": [
                "script import sys; sys.path.append('/usr/lib/python3.14/site-packages')",
                "command script import ${workspaceFolder}/visual/parse.py",
                "command script import ${workspaceFolder}/visual/line.py",
                "command script import ${workspaceFolder}/visual/profile.py",
                "command script import ${workspaceFolder}/visual/hist.py",
                "command script import ${workspaceFolder}/visual/eval.py",
            ]
        },

        {
            "name": "ring_cali_eval_gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ring_cali_eval",
            "cwd": "${workspaceFolder}",
            "args": [
                "cali/20260622"
            ],
            "preLaunchTask": "build_cali_eval",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreExisting": true
                }
            ]
        },

        {
            "name": "ring_measure_lldb",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/ring_measure",
            "cwd": "${workspaceFolder}",
            "args": [
                "measure/20260326/",
                "-c", "cali/20260622/auto/calibrations/",
                "-b",
                "-t", "measure/20260326/config/11.ini"
            ],
            "preLaunchTask": "build_measure",
            "initCommands": [
                "script import sys; sys.path.append('/usr/lib/python3.14/site-packages')",
                "command script import ${workspaceFolder}/visual/parse.py",
                "command script import ${workspaceFolder}/visual/line.py",
                "command script import ${workspaceFolder}/visual/profile.py",
                "command script import ${workspaceFolder}/visual/hist.py",
                "command script import ${workspaceFolder}/visual/eval.py",
            ]
        },

        {
            "name": "ring_measure_gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ring_measure",
            "cwd": "${workspaceFolder}",
            "args": [
                "measure/20260326/",
                "-c", "4_ND_20260622_4_10.ini",
                "-b",
                "-r", "measure/20260326/config/11.ini"
            ],
            "preLaunchTask": "build_measure",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreExisting": true
                }
            ]
        },

        // How does the wine dbg work?
        // The bash script will start the wine debugger and wait for a connection on dynamic port.
        // The app socat connects the dynamic port to a fixed port (localhost:40780) and forwards the data.
        // The gdb debugger will then connect to this fixed port and start debugging the program in VScode.
        // Then everything behaves like a normal gdb debugging session, except that the program is running in wine.
        // To modify the fixed port, change the port number in .vscode/start-wine-debug.sh and in this launch.json file.
        // If you want to modify the program arguments, see line 33-38 in .vscode/start-wine-debug.sh for details.
        // # To install socat:
        // $ sudo pacman -S socat
        // # To check if socat is installed:
        // $ which socat
        // # To test the port
        // $ ss -lntp | grep -E '38885|40780'
        // # To clean up the wine debugger process, run the following command:
        // $ pkill -f socat && pkill -f winedbg
        {
            "name": "Winedbg ring_cali.exe",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build-win/deploy/ring_cali.exe",
            "cwd": "${workspaceFolder}/build-win/deploy",

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/sbin/gdb",
            "miDebuggerServerAddress": "localhost:40780",
            "additionalSOLibSearchPath": "${workspaceFolder}/build-win/deploy",

            "stopAtEntry": false,
            "externalConsole": false,

            "preLaunchTask": "Start Wine debugger",
            "postDebugTask": "Stop Wine debugger",

            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}